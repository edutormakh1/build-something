{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "build-something-agents",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "build-something-agents"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_PEOPLE_SITE_URL": "https://buildsomethingpeoplewant.com",
    "NEXT_PUBLIC_AGENTS_SITE_URL": "https://buildsomethingagentswant.com"
  },
  "observability": {
    "enabled": true
  }
}
